[gd_scene format=3]

[ext_resource type="Script" path="res://ui/options_menu/options_menu.gd" id="script"]
[ext_resource type="Theme" path="res://ui/menu_theme.tres" id="theme"]

[node name="OptionsMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("theme")
script = ExtResource("script")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(360, 0)
layout_mode = 2

[node name="Content" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Title" type="Label" parent="Center/Panel/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 36
text = "Opções"
horizontal_alignment = 1

[node name="DarkMode" type="Button" parent="Center/Panel/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 64)
layout_mode = 2
toggle_mode = true
text = "Tema escuro"
tooltip_text = "Ativar ou desativar o tema escuro"
mouse_default_cursor_shape = 2

[connection signal="toggled" from="Center/Panel/Content/DarkMode" to="." method="_on_dark_mode_toggled"]

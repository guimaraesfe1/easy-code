[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://ui/repair_panel/repair_panel.gd" id="script"]
[ext_resource type="Theme" path="res://ui/repair_panel/industrial_theme.tres" id="theme"]
[ext_resource type="Script" path="res://ui/repair_panel/industrial_plate.gd" id="plate"]

[node name="RepairPanel" type="Control"]
process_mode = 3
visible = false
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("theme")
script = ExtResource("script")

[node name="Shade" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.015, 0.025, 0.045, 0.85)
mouse_filter = 0

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchor_left = 0.06
anchor_top = 0.06
anchor_right = 0.94
anchor_bottom = 0.94

[node name="Panel" type="PanelContainer" parent="Margin"]
layout_mode = 2
theme_type_variation = &"MetalFrame"
script = ExtResource("plate")

[node name="Content" type="VBoxContainer" parent="Margin/Panel"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Title" type="Label" parent="Margin/Panel/Content"]
layout_mode = 2
text = "Proposições"
theme_override_font_sizes/font_size = 28
horizontal_alignment = 1

[node name="Proposition" type="Label" parent="Margin/Panel/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 22
autowrap_mode = 3
horizontal_alignment = 1

[node name="TableScroll" type="ScrollContainer" parent="Margin/Panel/Content"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
follow_focus = true

[node name="CircuitBoard" type="PanelContainer" parent="Margin/Panel/Content/TableScroll"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
theme_type_variation = &"CircuitBoard"
script = ExtResource("plate")
kind = 1

[node name="Table" type="GridContainer" parent="Margin/Panel/Content/TableScroll/CircuitBoard"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/h_separation = 36
theme_override_constants/v_separation = 16
columns = 3

[node name="Feedback" type="Label" parent="Margin/Panel/Content"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(0, 28)
theme_override_font_sizes/font_size = 16
autowrap_mode = 3
horizontal_alignment = 1

[node name="Actions" type="HBoxContainer" parent="Margin/Panel/Content"]
layout_mode = 2
theme_override_constants/separation = 16
alignment = 1

[node name="Close" type="Button" parent="Margin/Panel/Content/Actions"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(130, 48)
text = "Fechar"

[node name="Submit" type="Button" parent="Margin/Panel/Content/Actions"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(170, 48)
theme_type_variation = &"RepairButton"
text = "Consertar"

[connection signal="pressed" from="Margin/Panel/Content/Actions/Close" to="." method="_on_close_pressed"]
[connection signal="pressed" from="Margin/Panel/Content/Actions/Submit" to="." method="_on_submit_pressed"]
